+    FanFlatBeamStripKernelProjector2D.cpp
+    FanFlatProjectionGeometry2D.cpp
+    FanFlatVecProjectionGeometry2D.cpp
+    Features.cpp
+    FilteredBackProjectionAlgorithm.cpp
+    Filters.cpp
