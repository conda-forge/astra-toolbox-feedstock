+# Collect source and header files --------------------------------------------
+set(ASTRA_SOURCES
+    Algorithm.cpp
+    ArtAlgorithm.cpp
+    AstraObjectFactory.cpp
+    AstraObjectManager.cpp
+    BackProjectionAlgorithm.cpp
