-
-	man.clear();
-
-	BOOST_CHECK(!man.hasIndex(i1));
-	BOOST_CHECK(!man.hasIndex(i2));
-	BOOST_CHECK(!man.hasIndex(i3));
-	BOOST_CHECK(!man.hasIndex(i4));
-	BOOST_CHECK(!man.getIndex(pi4));
